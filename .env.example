# Copy to .env and adjust. Every variable is optional; the defaults run fully offline.

# Optional narrative summary
# llm_provider: none | openai | anthropic
AISA_LLM_PROVIDER=none

# OPENAI_API_KEY is also accepted.
AISA_OPENAI_API_KEY=
AISA_OPENAI_BASE_URL=https://api.openai.com/v1
AISA_OPENAI_CHAT_MODEL=gpt-4o-mini

# ANTHROPIC_API_KEY is also accepted.
AISA_ANTHROPIC_API_KEY=
AISA_ANTHROPIC_MODEL=claude-sonnet-5
AISA_ANTHROPIC_MAX_TOKENS=600

# Assessment
AISA_MAX_MANIFEST_BYTES=1000000
AISA_HISTORY_DIR=.aisa/history

# Networking
AISA_HTTP_TIMEOUT_SECONDS=30
AISA_RETRY_ATTEMPTS=3
AISA_RETRY_MIN_WAIT=0.5
AISA_RETRY_MAX_WAIT=8

# Logging
AISA_LOG_LEVEL=WARNING
AISA_LOG_JSON=true
